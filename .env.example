# StoryMaker environment — copy to .env and fill in.
#
# Entirely optional for local editor testing: uploads, reordering, effects,
# and Review all work with no .env at all. Fill this in when you want to
# test real sign-up/sign-in/export against a Supabase project — see the
# README's "Supabase setup (accounts)" section for exact steps.
#
# The anon key is safe to expose to the browser (Supabase design; RLS protects
# data). NEVER put the service-role key or OAuth provider secrets here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
